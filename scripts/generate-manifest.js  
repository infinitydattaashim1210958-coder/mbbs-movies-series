const fs = require('fs');
const path = require('path');

function generateManifest() {
  const metadataDir = path.join(__dirname, '../metadata');
  const files = fs.readdirSync(metadataDir).filter(f => f.endsWith('.json'));
  const notes = [];

  for (const file of files) {
    try {
      const data = JSON.parse(fs.readFileSync(path.join(metadataDir, file), 'utf8'));
      if (data.published !== false) {
        notes.push(data);
      }
    } catch (err) {
      console.error(`Error parsing ${file}:`, err.message);
    }
  }

  // Sort by release year (newest first), then title
  notes.sort((a, b) => (b.releaseYear || 0) - (a.releaseYear || 0) || a.title.localeCompare(b.title));

  const manifest = {
    schemaVersion: 1,
    lastUpdated: new Date().toISOString(),
    notes
  };

  const outputPath = path.join(__dirname, '../public/manifest.json');
  // Ensure public directory exists
  if (!fs.existsSync(path.dirname(outputPath))) {
    fs.mkdirSync(path.dirname(outputPath), { recursive: true });
  }
  
  fs.writeFileSync(outputPath, JSON.stringify(manifest, null, 2));
  console.log(`✅ Manifest generated with ${notes.length} notes at public/manifest.json`);
}

generateManifest();
